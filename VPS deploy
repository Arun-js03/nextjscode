#!/bin/bash
# -----------------------------
# Next.js App VPS Deployment Script
# For Study / Practice Purpose
# -----------------------------

# 1️⃣ VPS Login
echo "Step 1: Make sure you are logged into VPS via SSH"
echo "ssh root@your-server-ip"
echo ""

# 2️⃣ System Update
echo "Step 2: Updating system packages..."
sudo apt update && sudo apt upgrade -y
echo "System update completed!"
echo ""

# 3️⃣ Node.js Check
echo "Step 3: Check Node.js & npm version"
node -v
npm -v
echo ""

# 4️⃣ Install PM2
echo "Step 4: Installing PM2..."
npm install -g pm2
pm2 -v
echo "PM2 installed!"
echo ""

# 5️⃣ Create Project Folder
echo "Step 5: Creating project folder..."
mkdir -p /bharat/www
cd /bharat/www || exit
echo "Project folder created at /bharat/www"
echo ""

# 6️⃣ Clone Project
echo "Step 6: Cloning your project from GitHub..."
# Replace the URL with your repo
git clone https://github.com/your-repo/next-app.git
cd next-app || exit
echo "Project cloned successfully!"
echo ""

# 7️⃣ Install Dependencies
echo "Step 7: Installing dependencies..."
# Use bun or npm based on your project
bun install
echo "Dependencies installed!"
echo ""

# 8️⃣ Build Project
echo "Step 8: Building project..."
bun run build
echo "Build completed!"
echo ""

# 9️⃣ Start App with PM2
echo "Step 9: Starting app using PM2..."
pm2 start npm --name "next-app" -- start
pm2 list
echo ""

# 🔹 PM2 Auto-start on server restart
echo "Enabling PM2 auto-start..."
pm2 startup
pm2 save
echo "PM2 auto-start enabled!"
echo ""

# 🔹 Optional: Install Nginx
echo "Step 11: Installing Nginx..."
sudo apt install nginx -y
sudo systemctl enable nginx
sudo systemctl start nginx
echo "Nginx installed!"
echo ""

# 🔹 Nginx reverse proxy config
echo "Step 12: Configure Nginx reverse proxy..."
echo "sudo nano /etc/nginx/sites-available/next-app"
echo "Paste the following content:"
echo "
server {
    listen 80;
    server_name yourdomain.com;

    location / {
        proxy_pass http://localhost:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade \$http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host \$host;
        proxy_cache_bypass \$http_upgrade;
    }
}
"
echo "Then enable site: sudo ln -s /etc/nginx/sites-available/next-app /etc/nginx/sites-enabled/"
echo "Reload Nginx: sudo systemctl reload nginx"
echo ""

# 🔹 Environmental variables
echo "Step 13: Create .env file in project root"
echo "nano .env"
echo "Then restart app:"
echo "pm2 restart next-app"
echo ""

# 🔹 PM2 Useful Commands
echo "✅ PM2 Commands:"
echo "Logs: pm2 logs next-app"
echo "Restart: pm2 restart next-app"
echo "Stop: pm2 stop next-app"

echo ""
echo "🎉 Deployment script study guide complete!"

